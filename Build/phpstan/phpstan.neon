# PHPStan configuration. Extensions (phpstan-typo3, psr-container) are loaded
# automatically through phpstan/extension-installer.
parameters:
    level: 5
    tmpDir: ../../.Build/.cache/phpstan
    paths:
        - ../../Classes
        - ../../Configuration
        - ../../Tests
        - ../../ext_localconf.php
    excludePaths:
        - ../../Configuration/TCA/Overrides/*
    treatPhpDocTypesAsCertain: false
